# ── Frontend (Vite) ─────────────────────────────────────────────
# mock — локальная заглушка (по умолчанию)
# pocketbase — реальный backend (фаза 2+)
VITE_API_MODE=mock

# URL PocketBase instance (используется при VITE_API_MODE=pocketbase)
VITE_API_URL=http://127.0.0.1:8090

# Web Push (фаза 3.3) — сгенерируйте: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kvartira.local
# PocketBase hook → relay (npm run push:relay)
WEB_PUSH_RELAY_URL=http://127.0.0.1:3001/send
PUSH_RELAY_PORT=3001
# Shared secret between the PB hook and the relay (required unless NODE_ENV=development)
WEB_PUSH_RELAY_SECRET=

# ── Registration invite ─────────────────────────────────────────
# KVARTIRA_DEV=1 allows the seeded (public) invite token.
# Leave unset on a server: registration then requires a rotated token
# from /admin/registration-qr.
KVARTIRA_DEV=

# ── PocketBase (docker-compose) ─────────────────────────────────
PB_HTTP_PORT=8090

# Seed script (npm run pb:seed) — superuser from Admin UI first launch
PB_URL=http://127.0.0.1:8090
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=changeme
